DISCORD_TOKEN=your_discord_token_here
PORT=3000

# File theme trong thư mục themes/ (mặc định miku)
THEME=miku

# Discord Application ID của bạn. Để trống sẽ dùng id trong themes/miku.js
# (application của tác giả gốc — không upload asset lên app đó được).
# CLIENT_ID=

# Ghi đè từng phần của theme. Bỏ trống = giữ giá trị trong file.
# RPC_NAME=Miku Nakano
# ROTATE_INTERVAL_MS=60000
# LARGE_IMAGE_URL=
# LARGE_IMAGE_TEXT=
# SMALL_IMAGE_URL=
# SMALL_IMAGE_TEXT=
# BUTTON_1_LABEL=
# BUTTON_1_URL=
# BUTTON_2_LABEL=
# BUTTON_2_URL=
